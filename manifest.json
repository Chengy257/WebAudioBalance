{
  "manifest_version": 3,
  "name": "WebAudioBalance",
  "version": "1.1.1",
  "description": "Smart tab loudness normalizer and perceptual balance across browser tabs (Manifest V3)",
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs",
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "WebAudioBalance",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "key": ""
}
