{
  "name": "webaudiobalance",
  "version": "1.1.0",
  "description": "Cross-tab perceptual loudness normalization and independent per-tab audio control for Chrome and Edge",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-poc.mjs edge",
    "start:edge": "node scripts/start-poc.mjs edge",
    "start:chrome": "node scripts/start-poc.mjs chrome",
    "test": "node test/test-r1-audio-core.mjs && node test/test-r2-runtime-state.mjs && node test/test-r3-ui.mjs",
    "test:r1": "node test/test-r1-audio-core.mjs",
    "test:r1:browser": "node test/run-r1-browser-validation.mjs",
    "test:r2": "node test/test-r2-runtime-state.mjs",
    "test:r2:browser": "node test/run-r2-browser-integration.mjs",
    "test:r3": "node test/test-r3-ui.mjs",
    "test:r3:e2e": "node test/run-r3-popup-e2e.mjs",
    "test:r3:compat": "node test/run-r3-compatibility.mjs",
    "test:fc1:e2e": "node test/run-fc1-production-e2e.mjs",
    "test:fc2:compat": "node test/run-r3-compatibility.mjs",
    "test:fc3:soak": "node test/run-fc3-soak.mjs",
    "test:rc1:multitab": "node test/run-release-correction-multitab.mjs",
    "test:all": "npm test",
    "test:cdp": "node test/inspect-cdp.mjs",
    "package": "node scripts/package-release.mjs"
  },
  "keywords": [
    "chrome-extension",
    "webaudio",
    "loudness-normalization",
    "tabcapture",
    "manifest-v3"
  ],
  "author": "",
  "license": "UNLICENSED"
}
